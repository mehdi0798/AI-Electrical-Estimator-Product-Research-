# Supabase connection for the participant app (Vite exposes VITE_* to the client).
# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API). The anon key is insert-only by RLS (see
# supabase/migrations/0001_event_log.sql), so it is safe to ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
